+      }).catch(() => ({ calle: null, lugar: '' }));
+    // La calle suele llegar antes: se enseña ya y, si luego hay edificio, se cambia
+    const sigue = () => turno === cartelTurno && !$('#cartel').hidden;
+    const { calle, lugar } = await pedirCalle;
+    const ponerPueblo = (nombre) => { $('#cartel-pueblo').textContent = (pueblo || lugar) !== nombre ? (pueblo || lugar) : ''; };
+    if (sigue() && calle) { ponerTextoCartel(calle); ponerPueblo(calle); }
+    const edificio = await pedirEdificio;
+    if (sigue() && edificio) { ponerTextoCartel(edificio); ponerPueblo(edificio); }
+  }
+  if (!$('#cartel').hidden && $('#cartel-sitio').textContent === 'Buscando el nombre…') ponerTextoCartel('📍 Sin nombre');
+}
+
+// Edificio o monumento importante cerca: los que tienen artículo en Wikipedia
+// (primero en español; si no hay, en italiano). Se queda con el más cercano,
+// dando ventaja a iglesias, museos, palacios, torres, plazas…
+const PALABRAS_EDIFICIO = /^(iglesia|catedral|bas[ií]lica|capilla|baptisterio|oratorio|templo|duomo|museo|galer[ií]a|palacio|palazzo|torre|castillo|fortaleza|fortezza|murallas?|puerta|porta|plaza|piazza|fuente|fontana|teatro|monasterio|convento|abad[ií]a|logia|loggia|puente|ponte|monumento|estatua|biblioteca|villa|chiesa|basilica|cattedrale|cappella|battistero|museo|abbazia|santuario|pieve|campanile|campanario|mercado|mercato)(?=[\s,]|$)/i;
+const NO_EDIFICIO = /^(archidi[oó]cesis|di[oó]cesis|arcidiocesi|diocesi|historia|storia|batalla|battaglia|lista|anexo|elenco)(?=[\s,]|$)/i;
+async function edificioCercano(pos) {
+  const radio = Math.round(50 + Math.min(pos.precision || 0, 25));
+  for (const idioma of ['es', 'it']) {
     try {
-      const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=17&accept-language=es&lat=${pos.lat.toFixed(5)}&lon=${pos.lng.toFixed(5)}`;
+      const url = `https://${idioma}.wikipedia.org/w/api.php?action=query&list=geosearch&gscoord=${pos.lat.toFixed(5)}%7C${pos.lng.toFixed(5)}&gsradius=${radio}&gslimit=10&format=json&origin=*`;
       const r = await (await fetch(url, { signal: AbortSignal.timeout(6000) })).json();
-      const a = r.address || {};
-      const calle = a.road || a.pedestrian || a.square || r.name;
-      const lugar = a.city || a.town || a.village || a.municipality || '';
-      if (!$('#cartel').hidden && calle) {
-        ponerTextoCartel(calle);
-        if (!pueblo || pueblo === calle) $('#cartel-pueblo').textContent = lugar !== calle ? lugar : '';
-        else $('#cartel-pueblo').textContent = pueblo;
-      }
-    } catch { /* sin conexión: se queda el pueblo */ }
+      const lista = (r.query?.geosearch || [])
+        .filter((x) => !NO_EDIFICIO.test(x.title))
+        .map((x) => ({ nombre: x.title.replace(/\s*\([^)]*\)\s*$/, ''), puntos: x.dist - (PALABRAS_EDIFICIO.test(x.title) ? 25 : 0) }))
+        .sort((a, b) => a.puntos - b.puntos);
+      if (lista.length) return lista[0].nombre;
+    } catch { /* sin conexión o sin respuesta: probar el otro idioma */ }
   }
-  if (!$('#cartel').hidden && $('#cartel-sitio').textContent === 'Buscando el nombre…') ponerTextoCartel('📍 Sin nombre');
+  return null;
 }
 
